# 이 파일을 secrets.properties 로 복사한 뒤 실제 값을 채우세요. (secrets.properties 는 git에 올라가지 않습니다)
# 환경 변수로 같은 이름을 지정해도 됩니다. (실행 디렉터리 기준 ./config/secrets.properties 를 읽음)
DB_USERNAME=
DB_PASSWORD=
# 로컬 개발용 DB 주소 예시 (생략하면 운영 DB 주소가 기본값으로 사용됨)
# DB_URL=jdbc:mariadb://localhost:3306/hjungcwoo?serverTimezone=UTC&characterEncoding=UTF-8&createDatabaseIfNotExist=true
MAIL_USERNAME=
MAIL_PASSWORD=
